{
  "name": "@naslukh/speech-rn",
  "version": "0.1.0",
  "description": "Offline Russian speech recognition for Expo and React Native on Android",
  "license": "MIT",
  "keywords": ["expo", "react-native", "speech-recognition", "offline", "russian", "android"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1yoga/naslukh.git",
    "directory": "packages/speech-rn"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-modules-core": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "typescript": "~5.3.3"
  }
}
