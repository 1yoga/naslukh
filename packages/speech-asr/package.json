{
  "name": "@naslukh/speech-asr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node-харнесс GigaAM: куски после VAD, склейка и сегменты в speech-store.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test test/*.test.ts",
    "run-file": "node --experimental-strip-types --experimental-sqlite src/cli.ts",
    "run-pipeline": "node --experimental-strip-types --experimental-sqlite src/pipeline-cli.ts",
    "run-engine": "node --experimental-strip-types --experimental-sqlite src/engine-cli.ts"
  }
}
