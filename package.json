{
  "name": "naslukh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck:speech-core": "tsc -p packages/speech-core --noEmit",
    "test:speech-core": "npm test --prefix packages/speech-core",
    "typecheck:speech-store": "tsc -p packages/speech-store --noEmit",
    "test:speech-store": "npm test --prefix packages/speech-store",
    "typecheck:speech-vad": "tsc -p packages/speech-vad --noEmit",
    "test:speech-vad": "npm test --prefix packages/speech-vad",
    "vad:file": "npm run run-file --prefix packages/speech-vad --",
    "typecheck:speech-asr": "tsc -p packages/speech-asr --noEmit",
    "test:speech-asr": "npm test --prefix packages/speech-asr",
    "asr:file": "npm run run-file --prefix packages/speech-asr --",
    "asr:pipeline": "npm run run-pipeline --prefix packages/speech-asr --",
    "typecheck:speech-audio": "tsc -p packages/speech-audio --noEmit",
    "test:speech-audio": "npm test --prefix packages/speech-audio",
    "typecheck:speech-web": "tsc -p packages/speech-web --noEmit",
    "test:speech-web": "npm test --prefix packages/speech-web",
    "wasm:probe": "npm run probe --prefix packages/speech-web"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@huggingface/transformers": "^3.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "piper-tts-web": "^1.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@evan/opus": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "sherpa-onnx-node": "^2.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
